# Variable names only. Supply values privately in the process environment.
# This file is documentation; the client does not load dotenv files.
CLASSCHARTS_PUPIL_CODE=
# ISO date: YYYY-MM-DD (converted to DD/MM/YYYY for the login form).
CLASSCHARTS_DOB=
# Dedicated private Google calendar ID (not the calendar's display name).
GOOGLE_CALENDAR_ID=
# Entire service account JSON, supplied privately as one environment value.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional non-secret settings. Defaults: Europe/London, 7 days back, 90 ahead.
CALENDAR_TIMEZONE=Europe/London
SYNC_DAYS_BACK=7
SYNC_DAYS_AHEAD=90
